# Plantilla de variables de entorno de NexoPyme AI.
# `.env` se carga automáticamente al iniciar config.settings mediante
# python-dotenv y load_dotenv(BASE_DIR / ".env", override=False). Las variables
# ya exportadas en el proceso tienen prioridad sobre `.env`.
# `.env` está ignorado por Git y no se versiona; esta plantilla solo contiene
# nombres y placeholders vacíos. No commitear valores reales.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Opcionales (T-20). Si se omiten, se usan los valores por defecto.
# DJANGO_SECURE_COOKIES marca las cookies de sesión y CSRF como Secure (HTTPS).
DJANGO_SECURE_COOKIES=False
# DJANGO_SESSION_COOKIE_AGE en segundos (mayor que cero); por defecto 1209600 (14 días).
DJANGO_SESSION_COOKIE_AGE=1209600
# DJANGO_LOG_LEVEL: DEBUG, INFO, WARNING, ERROR o CRITICAL; por defecto INFO.
DJANGO_LOG_LEVEL=INFO

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Pruebas: base fija nexopyme_bootstrap_test (prohibida en la Etapa 001)
MYSQL_TEST_USER=
MYSQL_TEST_PASSWORD=
