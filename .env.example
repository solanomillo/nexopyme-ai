# Plantilla de variables de entorno de NexoPyme AI.
# No hay cargador automático de `.env`: exportá estas variables en el
# entorno del proceso antes de ejecutar `manage.py`. `.env` es solo una
# referencia local no versionada y no se carga por sí sola.
# No commitear valores reales. Los valores vacíos deben completarse
# mediante provisión segura autorizada.

DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
